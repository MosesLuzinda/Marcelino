{
  "name": "marcelino-school",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "db:generate": "prisma generate --schema=packages/database/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=packages/database/prisma/schema.prisma",
    "db:push": "prisma db push --schema=packages/database/prisma/schema.prisma",
    "db:seed": "tsx packages/database/prisma/seed.ts",
    "db:studio": "pnpm --filter @marcelino/database studio",
    "demo:record": "pnpm --filter @marcelino/web demo:record",
    "demo:screenshots": "pnpm --filter @marcelino/web demo:screenshots",
    "test": "turbo test",
    "vercel-build": "pnpm -w run db:generate && pnpm --filter @marcelino/web run build"
  },
  "devDependencies": {
    "prisma": "^6.19.3",
    "tsx": "^4.22.3",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  }
}
