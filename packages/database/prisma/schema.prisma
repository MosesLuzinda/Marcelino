// Marcelino School Management Platform — Prisma Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING
}

enum RoleName {
  SUPER_ADMIN
  ADMIN
  FINANCE
  HR
  TEACHER
  STUDENT
  PARENT
  LIBRARIAN
  TRANSPORT
  HOSTEL
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum AssignmentStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum SubmissionStatus {
  PENDING
  SUBMITTED
  GRADED
  LATE
}

enum ExamStatus {
  DRAFT
  PUBLISHED
  ACTIVE
  CLOSED
}

enum InvoiceStatus {
  DRAFT
  PENDING
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentProvider {
  FLUTTERWAVE
  MTN_MOMO
  AIRTEL_MONEY
  STRIPE
  PAYPAL
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
  ANNOUNCEMENT
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum LoanStatus {
  ACTIVE
  RETURNED
  OVERDUE
  LOST
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PayrollStatus {
  DRAFT
  PROCESSING
  COMPLETED
  CANCELLED
}

// ─── Organization ────────────────────────────────────────────────────────────

model School {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  motto        String?
  email        String?
  phone        String?
  address      String?
  website      String?
  logo         String?
  foundedYear  Int?
  description  String?  @db.Text
  settings     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  campuses      Campus[]
  academicYears AcademicYear[]
  departments   Department[]
  users         User[]
  classes       Class[]
  currencies    Currency[]
  feeStructures FeeStructure[]

  @@index([slug])
}

model Campus {
  id        String   @id @default(cuid())
  schoolId  String
  name      String
  address   String?
  isMain    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classes Class[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

model AcademicYear {
  id        String   @id @default(cuid())
  schoolId  String
  name      String
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school        School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  terms         Term[]
  enrollments   Enrollment[]
  feeStructures FeeStructure[]
  reportCards   ReportCard[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@index([isCurrent])
}

model Term {
  id             String   @id @default(cuid())
  academicYearId String
  name           String
  startDate      DateTime
  endDate        DateTime
  isCurrent      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  grades       Grade[]
  invoices     Invoice[]
  reportCards  ReportCard[]

  @@unique([academicYearId, name])
  @@index([academicYearId])
  @@index([isCurrent])
}

model Department {
  id          String   @id @default(cuid())
  schoolId    String
  name        String
  description String?
  headId      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school   School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subjects Subject[]
  teachers TeacherProfile[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

// ─── Auth ────────────────────────────────────────────────────────────────────

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  firebaseUid   String?    @unique
  passwordHash  String?
  firstName     String
  lastName      String
  phone         String?
  avatar        String?
  locale        String?    @default("en")
  theme         String?    @default("light")
  status        UserStatus @default(ACTIVE)
  schoolId      String?
  emailVerified Boolean    @default(false)
  lastLoginAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  school           School?              @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  roles            UserRole[]
  refreshTokens    RefreshToken[]
  studentProfile   StudentProfile?
  teacherProfile   TeacherProfile?
  parentProfile    ParentProfile?
  staffProfile     StaffProfile?
  notifications    Notification[]
  conversationMembers ConversationMember[]
  sentMessages     Message[]            @relation("MessageSender")
  auditLogs        AuditLog[]
  announcements    Announcement[]       @relation("AnnouncementAuthor")
  blogPosts        BlogPost[]           @relation("BlogPostAuthor")
  eventBookings    EventBooking[]       @relation("EventBookingUser")
  chatbotLogs      ChatbotLog[]
  apiKeys          ApiKey[]

  @@index([schoolId])
  @@index([status])
  @@index([email])
}

model Role {
  id          String   @id @default(cuid())
  name        RoleName @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  id          String   @id @default(cuid())
  resource    String
  action      String
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@unique([resource, action])
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ─── Profiles ──────────────────────────────────────────────────────────────────

model StudentProfile {
  id            String    @id @default(cuid())
  userId        String    @unique
  studentId     String    @unique
  classId       String?
  sectionId     String?
  dateOfBirth   DateTime?
  gender        Gender?
  address       String?
  admissionDate DateTime?
  status        UserStatus @default(ACTIVE)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  class               Class?               @relation(fields: [classId], references: [id], onDelete: SetNull)
  section             Section?             @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  enrollments         Enrollment[]
  attendanceRecords   AttendanceRecord[]
  submissions         Submission[]
  examAttempts        ExamAttempt[]
  grades              Grade[]
  reportCards         ReportCard[]
  invoices            Invoice[]
  parentLinks         ParentStudentLink[]
  libraryLoans        LibraryLoan[]
  bedAssignments      BedAssignment[]
  transportAssignments TransportAssignment[]
  scholarships        StudentScholarship[]

  @@index([classId])
  @@index([sectionId])
  @@index([studentId])
}

model TeacherProfile {
  id              String    @id @default(cuid())
  userId          String    @unique
  employeeId      String    @unique
  departmentId    String?
  hireDate        DateTime?
  qualification   String?
  specialization  String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  department        Department?        @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  classSubjects     ClassSubject[]
  assignments       Assignment[]
  attendanceRecords AttendanceRecord[]
  grades            Grade[]
  exams             Exam[]
  timetableSlots    TimetableSlot[]

  @@index([departmentId])
  @@index([employeeId])
}

model ParentProfile {
  id         String   @id @default(cuid())
  userId     String   @unique
  occupation String?
  workplace  String?
  address    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  children ParentStudentLink[]
}

model ParentStudentLink {
  id           String  @id @default(cuid())
  parentId     String
  studentId    String
  relationship String?
  isPrimary    Boolean @default(false)
  createdAt    DateTime @default(now())

  parent  ParentProfile  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])
  @@index([studentId])
}

model StaffProfile {
  id         String    @id @default(cuid())
  userId     String    @unique
  employeeId String    @unique
  department String?
  position   String?
  hireDate   DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  leaveRequests LeaveRequest[]
  payrollEntries PayrollEntry[]

  @@index([employeeId])
}

// ─── Academics ─────────────────────────────────────────────────────────────────

model Class {
  id         String   @id @default(cuid())
  schoolId   String
  campusId   String?
  name       String
  gradeLevel Int?
  capacity   Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  school         School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campus         Campus?          @relation(fields: [campusId], references: [id], onDelete: SetNull)
  sections       Section[]
  students       StudentProfile[]
  classSubjects  ClassSubject[]
  enrollments    Enrollment[]
  timetableSlots TimetableSlot[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@index([campusId])
  @@map("classes")
}

model Section {
  id        String   @id @default(cuid())
  classId   String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  class    Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  students StudentProfile[]

  @@unique([classId, name])
  @@index([classId])
}

model Subject {
  id           String   @id @default(cuid())
  departmentId String
  name         String
  code         String   @unique
  credits      Int      @default(1)
  description  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department    Department     @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  courses       Course[]
  classSubjects ClassSubject[]
  timetableSlots TimetableSlot[]

  @@index([departmentId])
}

model Course {
  id          String        @id @default(cuid())
  subjectId   String
  title       String
  description String?       @db.Text
  status      ContentStatus @default(DRAFT)
  thumbnail   String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  subject         Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  assignments     Assignment[]
  exams           Exam[]
  lessonMaterials LessonMaterial[]

  @@index([subjectId])
  @@index([status])
}

model ClassSubject {
  id        String   @id @default(cuid())
  classId   String
  subjectId String
  teacherId String?
  createdAt DateTime @default(now())

  class   Class          @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher TeacherProfile? @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  @@unique([classId, subjectId])
  @@index([teacherId])
}

model Enrollment {
  id             String   @id @default(cuid())
  studentId      String
  academicYearId String
  classId        String
  enrolledAt     DateTime @default(now())
  status         String   @default("active")
  createdAt      DateTime @default(now())

  student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYear AcademicYear   @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  class        Class          @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([studentId, academicYearId])
  @@index([academicYearId])
  @@index([classId])
}

model TimetableSlot {
  id         String  @id @default(cuid())
  classId    String
  subjectId  String
  teacherId  String?
  dayOfWeek  Int
  startTime  String
  endTime    String
  room       String?
  meetLink   String?
  zoomLink   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  class   Class           @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject Subject         @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher TeacherProfile? @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  @@index([classId, dayOfWeek])
  @@index([teacherId])
}

model LessonMaterial {
  id        String   @id @default(cuid())
  courseId  String
  title     String
  type      String?
  fileUrl   String?
  content   String?  @db.Text
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
}

// ─── Attendance & Assessment ─────────────────────────────────────────────────

model AttendanceRecord {
  id        String           @id @default(cuid())
  studentId String
  teacherId String?
  date      DateTime         @db.Date
  status    AttendanceStatus
  remarks   String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  student StudentProfile  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacher TeacherProfile? @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  @@unique([studentId, date])
  @@index([date])
  @@index([teacherId])
}

model Assignment {
  id          String           @id @default(cuid())
  courseId    String
  teacherId   String
  title       String
  description String?          @db.Text
  dueDate     DateTime
  maxScore    Decimal          @default(100) @db.Decimal(10, 2)
  status      AssignmentStatus @default(DRAFT)
  attachments Json?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  course      Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacher     TeacherProfile   @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  submissions Submission[]

  @@index([courseId])
  @@index([teacherId])
  @@index([dueDate])
}

model Submission {
  id           String           @id @default(cuid())
  assignmentId String
  studentId    String
  content      String?          @db.Text
  fileUrl      String?
  status       SubmissionStatus @default(PENDING)
  score        Decimal?         @db.Decimal(10, 2)
  feedback     String?          @db.Text
  submittedAt  DateTime?
  gradedAt     DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  assignment Assignment     @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
  @@index([studentId])
}

model Exam {
  id          String     @id @default(cuid())
  courseId    String?
  teacherId   String
  title       String
  description String?    @db.Text
  duration    Int?
  startTime   DateTime?
  endTime     DateTime?
  status      ExamStatus @default(DRAFT)
  totalMarks  Decimal?   @db.Decimal(10, 2)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  course    Course?        @relation(fields: [courseId], references: [id], onDelete: SetNull)
  teacher   TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  questions ExamQuestion[]
  attempts  ExamAttempt[]

  @@index([teacherId])
  @@index([courseId])
  @@index([status])
}

model ExamQuestion {
  id            String  @id @default(cuid())
  examId        String
  question      String  @db.Text
  options       Json?
  correctAnswer String?
  marks         Decimal @default(1) @db.Decimal(10, 2)
  order         Int     @default(0)

  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@index([examId])
}

model ExamAttempt {
  id          String    @id @default(cuid())
  examId      String
  studentId   String
  answers     Json?
  score       Decimal?  @db.Decimal(10, 2)
  startedAt   DateTime  @default(now())
  submittedAt DateTime?

  exam    Exam           @relation(fields: [examId], references: [id], onDelete: Cascade)
  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([examId, studentId])
  @@index([studentId])
}

model Grade {
  id        String   @id @default(cuid())
  studentId String
  teacherId String?
  termId    String?
  subject   String
  score     Decimal  @db.Decimal(10, 2)
  maxScore  Decimal  @default(100) @db.Decimal(10, 2)
  grade     String?
  remarks   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student StudentProfile  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacher TeacherProfile? @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  term    Term?           @relation(fields: [termId], references: [id], onDelete: SetNull)

  @@index([studentId])
  @@index([termId])
  @@index([subject])
}

model ReportCard {
  id             String   @id @default(cuid())
  studentId      String
  termId         String
  academicYearId String?
  gpa            Decimal? @db.Decimal(5, 2)
  rank           Int?
  remarks        String?
  pdfUrl         String?
  generatedAt    DateTime @default(now())
  createdAt      DateTime @default(now())

  student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  term         Term           @relation(fields: [termId], references: [id], onDelete: Cascade)
  academicYear AcademicYear?  @relation(fields: [academicYearId], references: [id], onDelete: SetNull)

  @@unique([studentId, termId])
  @@index([academicYearId])
}

// ─── Communication & CMS ───────────────────────────────────────────────────────

model Conversation {
  id        String   @id @default(cuid())
  title     String?
  isGroup   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members  ConversationMember[]
  messages Message[]
}

model ConversationMember {
  id             String   @id @default(cuid())
  conversationId String
  userId         String
  joinedAt       DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String    @id @default(cuid())
  conversationId String
  senderId       String
  content        String    @db.Text
  attachments    Json?
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType @default(INFO)
  title     String
  body      String           @db.Text
  link      String?
  read      Boolean          @default(false)
  data      Json?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([createdAt])
}

model Announcement {
  id          String        @id @default(cuid())
  title       String
  content     String        @db.Text
  audience    String        @default("all")
  status      ContentStatus @default(DRAFT)
  authorId    String?
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  author User? @relation("AnnouncementAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([publishedAt])
}

model BlogPost {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  excerpt     String?
  content     String        @db.Text
  coverImage  String?
  authorId    String?
  tags        String[]
  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  author User? @relation("BlogPostAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([publishedAt])
}

model Event {
  id          String    @id @default(cuid())
  title       String
  description String?   @db.Text
  location    String?
  startDate   DateTime
  endDate     DateTime?
  category    String?
  imageUrl    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([startDate])
  @@index([category])
}

model GalleryItem {
  id          String   @id @default(cuid())
  title       String
  imageUrl    String
  category    String?
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([category])
  @@index([order])
}

model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String   @db.Text
  category  String?
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([category])
  @@index([order])
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  role      String?
  content   String   @db.Text
  rating    Int      @default(5)
  imageUrl  String?
  featured  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([featured])
}

model Career {
  id           String        @id @default(cuid())
  title        String
  department   String?
  description  String        @db.Text
  requirements String?       @db.Text
  type         String?
  status       ContentStatus @default(DRAFT)
  deadline     DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  applications JobApplication[]

  @@index([status])
}

model JobApplication {
  id           String   @id @default(cuid())
  careerId     String
  name         String
  email        String
  phone        String?
  resumeUrl    String?
  coverLetter  String?  @db.Text
  status       String   @default("pending")
  createdAt    DateTime @default(now())

  career Career @relation(fields: [careerId], references: [id], onDelete: Cascade)

  @@index([careerId])
  @@index([email])
}

model Download {
  id          String   @id @default(cuid())
  title       String
  fileUrl     String
  category    String?
  description String?
  createdAt   DateTime @default(now())

  @@index([category])
}

model CmsPage {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  content   String   @db.Text
  meta      Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String   @db.Text
  status    String   @default("new")
  createdAt DateTime @default(now())

  @@index([status])
  @@index([createdAt])
}

// ─── Finance ───────────────────────────────────────────────────────────────────

model Currency {
  id        String   @id @default(cuid())
  schoolId  String
  code      String
  name      String
  symbol    String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  school         School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  exchangeRates  ExchangeRate[]
  invoices       Invoice[]

  @@unique([schoolId, code])
  @@index([schoolId])
}

model ExchangeRate {
  id            String   @id @default(cuid())
  currencyId    String
  rate          Decimal  @db.Decimal(18, 6)
  effectiveDate DateTime @default(now())
  createdAt     DateTime @default(now())

  currency Currency @relation(fields: [currencyId], references: [id], onDelete: Cascade)

  @@index([currencyId, effectiveDate])
}

model FeeStructure {
  id             String   @id @default(cuid())
  schoolId       String
  academicYearId String?
  name           String
  totalAmount    Decimal  @db.Decimal(14, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  school       School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  items        FeeItem[]

  @@index([schoolId])
  @@index([academicYearId])
}

model FeeItem {
  id             String  @id @default(cuid())
  feeStructureId String
  name           String
  amount         Decimal @db.Decimal(14, 2)
  description    String?

  feeStructure FeeStructure @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)

  @@index([feeStructureId])
}

model Scholarship {
  id            String   @id @default(cuid())
  name          String
  description   String?  @db.Text
  type          String?
  value         Decimal  @db.Decimal(14, 2)
  isPercentage  Boolean  @default(false)
  maxRecipients Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  students StudentScholarship[]
}

model StudentScholarship {
  id            String    @id @default(cuid())
  studentId     String
  scholarshipId String
  startDate     DateTime  @default(now())
  endDate       DateTime?
  amount        Decimal?  @db.Decimal(14, 2)
  createdAt     DateTime  @default(now())

  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  scholarship Scholarship    @relation(fields: [scholarshipId], references: [id], onDelete: Cascade)

  @@unique([studentId, scholarshipId])
  @@index([scholarshipId])
}

model Invoice {
  id         String        @id @default(cuid())
  invoiceNo  String        @unique
  studentId  String
  termId     String?
  currencyId String?
  subtotal   Decimal       @db.Decimal(14, 2)
  tax        Decimal       @default(0) @db.Decimal(14, 2)
  discount   Decimal       @default(0) @db.Decimal(14, 2)
  total      Decimal       @db.Decimal(14, 2)
  paidAmount Decimal       @default(0) @db.Decimal(14, 2)
  status     InvoiceStatus @default(PENDING)
  dueDate    DateTime
  items      Json?
  notes      String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  student  StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  term     Term?          @relation(fields: [termId], references: [id], onDelete: SetNull)
  currency Currency?      @relation(fields: [currencyId], references: [id], onDelete: SetNull)
  payments Payment[]
  receipts Receipt[]

  @@index([studentId])
  @@index([status])
  @@index([dueDate])
}

model Payment {
  id          String          @id @default(cuid())
  invoiceId   String
  amount      Decimal         @db.Decimal(14, 2)
  provider    PaymentProvider
  providerRef String?
  status      PaymentStatus   @default(PENDING)
  metadata    Json?
  paidAt      DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  receipt Receipt?

  @@index([invoiceId])
  @@index([providerRef])
  @@index([status])
}

model Receipt {
  id        String   @id @default(cuid())
  paymentId String   @unique
  invoiceId String
  receiptNo String   @unique
  createdAt DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model PayrollRun {
  id          String        @id @default(cuid())
  name        String
  period      String
  status      PayrollStatus @default(DRAFT)
  processedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  entries PayrollEntry[]

  @@index([status])
}

model PayrollEntry {
  id           String  @id @default(cuid())
  payrollRunId String
  staffId      String?
  employeeId   String?
  baseSalary   Decimal @db.Decimal(14, 2)
  deductions   Decimal @default(0) @db.Decimal(14, 2)
  bonuses      Decimal @default(0) @db.Decimal(14, 2)
  netPay       Decimal @db.Decimal(14, 2)

  payrollRun PayrollRun    @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  staff      StaffProfile? @relation(fields: [staffId], references: [id], onDelete: SetNull)

  @@index([payrollRunId])
  @@index([staffId])
}

// ─── Library ───────────────────────────────────────────────────────────────────

model Book {
  id        String   @id @default(cuid())
  title     String
  author    String?
  isbn      String?  @unique
  copies    Int      @default(1)
  available Int      @default(1)
  category  String?
  publisher String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  loans LibraryLoan[]

  @@index([title])
  @@index([category])
}

model LibraryLoan {
  id         String     @id @default(cuid())
  bookId     String
  studentId  String
  issuedAt   DateTime   @default(now())
  dueDate    DateTime
  returnedAt DateTime?
  status     LoanStatus @default(ACTIVE)
  fine       Decimal?   @db.Decimal(10, 2)

  book    Book           @relation(fields: [bookId], references: [id], onDelete: Cascade)
  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([bookId])
  @@index([studentId])
  @@index([status])
}

// ─── Hostel ────────────────────────────────────────────────────────────────────

model Hostel {
  id        String   @id @default(cuid())
  name      String
  gender    String?
  address   String?
  wardenId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rooms HostelRoom[]

  @@index([name])
}

model HostelRoom {
  id       String @id @default(cuid())
  hostelId String
  number   String
  capacity Int    @default(1)
  floor    Int?

  hostel Hostel          @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  beds   BedAssignment[]

  @@unique([hostelId, number])
  @@index([hostelId])
}

model BedAssignment {
  id        String    @id @default(cuid())
  roomId    String
  studentId String
  bedNumber String
  startDate DateTime
  endDate   DateTime?

  room    HostelRoom     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([roomId, bedNumber])
  @@index([studentId])
}

// ─── Transport ─────────────────────────────────────────────────────────────────

model Route {
  id          String   @id @default(cuid())
  name        String
  stops       Json?
  fare        Decimal? @db.Decimal(14, 2)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  vehicles    Vehicle[]
  assignments TransportAssignment[]

  @@index([name])
}

model Vehicle {
  id          String  @id @default(cuid())
  routeId     String
  plateNumber String  @unique
  capacity    Int?
  driverName  String?
  driverPhone String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  route Route @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@index([routeId])
}

model TransportAssignment {
  id          String   @id @default(cuid())
  studentId   String
  routeId     String
  pickupPoint String?
  dropPoint   String?
  createdAt   DateTime @default(now())

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  route   Route          @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@unique([studentId, routeId])
  @@index([routeId])
}

// ─── Inventory ─────────────────────────────────────────────────────────────────

model InventoryItem {
  id        String   @id @default(cuid())
  name      String
  sku       String   @unique
  category  String?
  quantity  Int      @default(0)
  minStock  Int      @default(0)
  unit      String?
  location  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  movements StockMovement[]

  @@index([category])
  @@index([name])
}

model StockMovement {
  id        String   @id @default(cuid())
  itemId    String
  type      String
  quantity  Int
  reason    String?
  reference String?
  createdBy String?
  createdAt DateTime @default(now())

  item InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@index([createdAt])
}

// ─── HR ────────────────────────────────────────────────────────────────────────

model LeaveRequest {
  id         String    @id @default(cuid())
  staffId    String
  type       String
  startDate  DateTime
  endDate    DateTime
  reason     String?   @db.Text
  status     String    @default("pending")
  approvedBy String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  staff StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
  @@index([status])
}

// ─── Facilities & Events ───────────────────────────────────────────────────────

model Facility {
  id          String   @id @default(cuid())
  name        String
  type        String?
  capacity    Int?
  location    String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bookings EventBooking[]

  @@index([type])
}

model EventBooking {
  id         String        @id @default(cuid())
  facilityId String
  title      String
  startTime  DateTime
  endTime    DateTime
  bookedById String?
  purpose    String?
  status     BookingStatus @default(PENDING)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  bookedBy User?    @relation("EventBookingUser", fields: [bookedById], references: [id], onDelete: SetNull)

  @@index([facilityId])
  @@index([bookedById])
  @@index([startTime])
}

// ─── System ────────────────────────────────────────────────────────────────────

model ChatbotLog {
  id        String   @id @default(cuid())
  userId    String?
  message   String   @db.Text
  response  String   @db.Text
  sessionId String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String?
  entityId  String?
  metadata  Json?
  ipAddress String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  category  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
}

model BackupMetadata {
  id          String    @id @default(cuid())
  filename    String
  size        Int?
  type        String?
  status      String    @default("pending")
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([status])
  @@index([createdAt])
}

model ApiKey {
  id          String    @id @default(cuid())
  userId      String?
  name        String
  keyHash     String
  prefix      String?
  permissions Json?
  expiresAt   DateTime?
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([prefix])
}
